# ========================================================
# Agente de Verificación y Validación Anti-Spam (Ecoruta)
# ========================================================

# URL Base del backend receptor de Ecoruta (Java REST API)
ECORUTA_BACKEND_URL=http://localhost:8085

# Puerto del microservicio de validación
PORT=5050

# Conexión directa a PostgreSQL para validación de duplicados y proximidad
DATABASE_URL=postgresql://postgres:Zelaya11@localhost:5432/ruteo_db

# Umbral mínimo de confianza para aprobar denuncia (0.00 a 1.00)
AGENT_MIN_CONFIDENCE=0.70

# Radio máximo en metros para detectar duplicados cercanos
AGENT_DUPLICATE_RADIUS_METERS=150

# Ventana de tiempo (en horas) para buscar reportes duplicados activos
AGENT_DUPLICATE_WINDOW_HOURS=48

# Límites geográficos de la jurisdicción (Gran Asunción)
AGENT_GEO_BOUNDS_LAT_MIN=-25.40
AGENT_GEO_BOUNDS_LAT_MAX=-25.18
AGENT_GEO_BOUNDS_LON_MIN=-57.72
AGENT_GEO_BOUNDS_LON_MAX=-57.48

# Credencial opcional para enriquecimiento multimodal con Gemini Vision AI
GEMINI_API_KEY=
